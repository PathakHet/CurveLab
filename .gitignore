# Real desk data stays out of the repo. Only the synthetic sample is committed.
data/*
!data/sample/
*.xlsx
!data/sample/Sample Trade Journal.xlsx

# Private config pointing at the real data, and personal notes.
configs/*
!configs/example.yaml
RESUME_BRIEF.md

# Generated by `make run`.
reports/REPORT.md
reports/results/*.csv
reports/figures/*.png
!reports/figures/.gitkeep

__pycache__/
*.py[cod]
*.so
.venv/
.pytest_cache/
.coverage
.hypothesis/
htmlcov/
build/
dist/
*.egg-info/
bench/bench_engine
